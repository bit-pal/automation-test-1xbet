# Copy to .env and fill in. .env is gitignored — never commit real values.
# ToR section 6: all confidential data lives here, never in the source.

# --- Required ---
SITE_LOGIN=
SITE_PASSWORD=
# The customer's own test number, full E.164 (e.g. +17173069020). Required only
# for CODE_SOURCE=manual; the gateway source supplies its own number.
TEST_PHONE_NUMBER=

# --- Target ---
# Note 127.0.0.1, not localhost: localhost may resolve to ::1 first, where the
# demo server does not answer.
SITE_URL=http://127.0.0.1:3000

# --- Code source: manual | gateway ---
# manual  = the operator types the code (default, needs no extra setup)
# gateway = poll the permitted test SMS API
CODE_SOURCE=manual

# Only for CODE_SOURCE=gateway, and only against the permitted test API. The
# gateway assigns the activation when the number is requested — nothing to set.
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_COUNTRY=5
SMS_SERVICE=1xb

# --- Reporting ---
# Recorded in the report as written. Automatic IP geolocation is deliberately
# not performed: it would send this machine's address to a third party.
RUN_GEO=

# --- Limits ---
CODE_TIMEOUT_MS=120000
MAX_CODE_ATTEMPTS=3
LOG_DIR=logs
ARTIFACTS_DIR=artifacts

# Set DEBUG=1 for verbose diagnostic output (secrets are still redacted).
DEBUG=
